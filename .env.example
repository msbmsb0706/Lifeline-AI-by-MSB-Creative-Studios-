# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NEBIUS_API_KEY: Server-side API key for Nebius Token Factory
# Configure this in your environment to enable Nemotron LLM emergency classification.
NEBIUS_API_KEY=""

# NEBIUS_BASE_URL / NEBIUS_BASE_URI: Nebius Token Factory API base endpoint (default: https://api.studio.nebius.ai/v1)
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"
NEBIUS_BASE_URI="https://api.studio.nebius.ai/v1"

# NEBIUS_MODEL: Model to invoke (e.g., nvidia/llama-3.1-nemotron-70b-instruct)
NEBIUS_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
