# NEBIUS_API_KEY: Server-side API key for Nebius Token Factory
# Configure this in your environment to enable Nemotron LLM emergency classification.
NEBIUS_API_KEY=""

# NEBIUS_BASE_URL / NEBIUS_BASE_URI: Nebius Token Factory API base endpoint (default: https://api.studio.nebius.ai/v1)
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"
NEBIUS_BASE_URI="https://api.studio.nebius.ai/v1"

# NEBIUS_MODEL: Model to invoke (e.g., nvidia/llama-3.1-nemotron-70b-instruct)
NEBIUS_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# ---------------------------------------------------------------------------
# Multilingual Voice ASR (speech-to-text) - OPTIONAL, SERVER-SIDE ONLY.
# ---------------------------------------------------------------------------
# Verified landscape (2026-09):
#   * Nebius Token Factory exposes NO speech/audio endpoints (LLM inference
#     only), so ASR cannot run through the existing Nebius configuration.
#   * NVIDIA's multilingual ASR is the `openai/whisper-large-v3` NIM: batch
#     transcription with automatic language detection (`language=multi`),
#     OpenAI-compatible multipart API, covering all 10 LifeLine languages
#     (English, Tamil, Hindi, Telugu, Kannada, Malayalam, Bengali, Marathi,
#     Spanish, French). NVIDIA-hosted access requires an API key from
#     build.nvidia.com; a self-hosted NVIDIA NIM container uses the same
#     request shape. NVIDIA Riva offers streaming ASR over gRPC but needs
#     separate credentials/infrastructure.
# When ASR is NOT configured, the app automatically falls back to the existing
# browser Web Speech API voice path (English) and typed text in any language.
#
# ASR_PROVIDER: 'nvidia_nim' (default) or 'none' to disable voice ASR entirely.
ASR_PROVIDER="nvidia_nim"
# ASR_BASE_URL: OpenAI-compatible audio base URL.
#   NVIDIA-hosted NIM: https://ai.api.nvidia.com/v1
#   Self-hosted NIM:   http://<your-nim-host>:9000/v1
ASR_BASE_URL="https://ai.api.nvidia.com/v1"
# ASR_API_KEY: Server-side ASR credentials. Never expose to the frontend.
# NVIDIA_API_KEY is also accepted (build.nvidia.com keys start with nvapi-).
ASR_API_KEY=""
# ASR_MODEL: Multilingual ASR model served at the base URL.
ASR_MODEL="openai/whisper-large-v3"
# ASR_LANGUAGE: 'multi' enables automatic language detection (recommended).
# Set an ISO-639-1 code to pin one language, or '' to omit the field.
ASR_LANGUAGE="multi"
# iOS LIMITATION (known, documented): Safari on iOS records audio/mp4 (AAC).
# NVIDIA-hosted whisper-large-v3 documents WAV/OPUS/FLAC inputs, so iOS
# recordings may be rejected by the hosted endpoint until a self-hosted NIM
# that accepts AAC or a small server-side transcode step is added. Intentionally
# NOT bundled to avoid a large transcoding dependency. Android/Chrome
# (audio/webm Opus) is unaffected.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Privacy Contact Form (POST /api/privacy-contact) — SERVER-SIDE ONLY
# ---------------------------------------------------------------------------
# PRIVACY_CONTACT_EMAIL: Private destination mailbox for Privacy Contact Form
# submissions. Set the real value ONLY in the production environment / secrets
# panel. Never commit it, never put it in a VITE_* variable, never hard-code it
# in client code. Leave empty here.
PRIVACY_CONTACT_EMAIL=""

# SMTP relay used by the server to deliver Privacy Contact Form messages.
# Any standard SMTP provider works (for Gmail use an App Password, port 587).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Optional sender address for relayed messages (defaults to SMTP_USER).
PRIVACY_CONTACT_FROM=""

# Optional: Express "trust proxy" setting for correct per-client rate limiting
# behind a hosting proxy. Defaults to 1 hop when NODE_ENV=production.
# TRUST_PROXY="1"
